# Weather provider (server-side only — never prefix with NEXT_PUBLIC_).
# Defaults to the free Open-Meteo API, which needs no key. For the commercial
# tier set WEATHER_API_BASE_URL=https://customer-api.open-meteo.com/v1 and a key.
WEATHER_API_KEY=
WEATHER_API_BASE_URL=

# Optional overrides for location search / reverse geocoding.
GEOCODING_API_BASE_URL=
REVERSE_GEOCODING_API_BASE_URL=
